{
  // Profile READMEs need centered HTML and long prose lines.
  "config": {
    "default": true,
    "MD013": false, // line length — prose is wrapped by hand, not to a column
    "MD033": false, // inline HTML — required for centered profile header / <sub>
    "MD041": false  // first line in file should be a top-level heading (it's HTML here)
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules"]
}
